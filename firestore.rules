rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Reading your own doc never needs to compare against anything —
      // safe even before the doc exists (Firestore just returns 404).
      allow read: if request.auth != null && request.auth.uid == uid;

      // Creating your own doc for the first time. We allow the doc to be
      // created WITH a premium field only if it's exactly `false` — this
      // lets new signups show up with a visible, ready-to-flip checkbox in
      // Firebase Console. Creating with premium:true is never allowed.
      allow create: if request.auth != null && request.auth.uid == uid
        && (!("premium" in request.resource.data) || request.resource.data.premium == false);

      // Updating an existing doc. Now `resource.data` safely exists, so we
      // can compare old vs new to block clients from setting `premium`
      // themselves — only you (Firebase Console) or the backend (Admin SDK,
      // which bypasses these rules entirely) can flip that field.
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["premium"]);
    }
  }
}
